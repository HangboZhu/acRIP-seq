# 大文件：容器镜像（sif 2.4G + sandbox ~5G），从 CNCB easyomics 重新下载
Containers/*.sif
Containers/*.sandbox
Containers/*.sandbox/
Containers/*.part
Containers/*.log

# 运行产物：试跑/正式跑的输出（qc/trim/bam/报告等，可重新生成）
result_trial/
result/

# Snakemake 元数据与临时目录
.snakemake/
.java/
.cache/
__pycache__/
*.pyc

# 大文件：STAR 基因组索引（~28G，可用 slurm/build_star_index.sbatch 重建）
References/STAR_*/
# 大文件：标准染色体过滤版 GTF（1.3G，可从共享区 GTF 用 awk 重建，见 config.trial.yaml 注释）
References/*.gtf

# 多物种扩展(2026-11-20)后新增的忽略项
# 参考基因组/索引/下载原始文件(113G, 可用 slurm/build_star_index*.sbatch 重建或重新下载)
References/
# 各物种正式跑产物(可重新生成; result_trial/ 之前已忽略)
result_*/
# 运行日志
logs/
# samtools sort 被杀后残留在仓库根目录的临时分片
samtools.*.tmp.*.bam
# sbatch spool 泄漏进 Scripts/species/ 的作业副本
Scripts/species/*.idxjob
