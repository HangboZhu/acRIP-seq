        mkdir -p /hpcdisk1/apod/shijiachen/yuliao/acRIPseq_pipeline/result_trial/logs/mark_duplicates
        if [ "pe" = "pe" ] && [ "True" = "True" ]; then
            VIEW_FILTER="-f 0x2 -q 255"
        else
            VIEW_FILTER="-q 255"
        fi

        samtools sort -n -@ 8 /hpcdisk1/apod/shijiachen/yuliao/acRIPseq_pipeline/result_trial/bam/GSE287582.MT4.WT.rep3.IP.Aligned.sortedByCoord.out.bam | \
            samtools view $VIEW_FILTER -b | \
            samtools fixmate -m -r - - | \
            samtools sort -@ 8 - | \
            samtools markdup -r -s - /hpcdisk1/apod/shijiachen/yuliao/acRIPseq_pipeline/result_trial/bam/GSE287582.MT4.WT.rep3.IP.DeDup.bam 2> /hpcdisk1/apod/shijiachen/yuliao/acRIPseq_pipeline/result_trial/bam/GSE287582.MT4.WT.rep3.IP.DeDup.log

        samtools flagstat /hpcdisk1/apod/shijiachen/yuliao/acRIPseq_pipeline/result_trial/bam/GSE287582.MT4.WT.rep3.IP.DeDup.bam > /hpcdisk1/apod/shijiachen/yuliao/acRIPseq_pipeline/result_trial/bam/GSE287582.MT4.WT.rep3.IP.flagstat.txt
        samtools index /hpcdisk1/apod/shijiachen/yuliao/acRIPseq_pipeline/result_trial/bam/GSE287582.MT4.WT.rep3.IP.DeDup.bam
        cat /hpcdisk1/apod/shijiachen/yuliao/acRIPseq_pipeline/result_trial/bam/GSE287582.MT4.WT.rep3.IP.DeDup.log > /hpcdisk1/apod/shijiachen/yuliao/acRIPseq_pipeline/result_trial/logs/mark_duplicates/GSE287582.MT4.WT.rep3.IP.log
        
